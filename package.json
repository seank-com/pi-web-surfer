{
  "name": "@seank/pi-web-surfer",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension that lets an agent browse the web",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/seank-com/pi-web-surfer.git"
  },
  "files": [
    "dist",
    "python/bridge.py",
    "python/requirements.in",
    "python/requirements.lock",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.ts",
    "build": "node scripts/build.ts",
    "test:package": "npm run build && node --test tests/package.test.ts",
    "test:integration": "npm run build && node --test tests/integration.ts",
    "check:private": "node scripts/check-private-terms.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "24.3.1",
    "typebox": "1.3.27",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "dependencies": {
    "undici": "7.30.1"
  }
}
